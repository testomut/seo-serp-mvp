# Copy this file to .env and fill in what you have. Every key is optional:
# the program runs without any of them, just with fewer features.

# --- Google search results: one of the two is enough, SearchApi is used first ---
# https://www.searchapi.io (free: 100 searches/month), https://serpapi.com (free: 250 searches/month)
# Without both: demo results from data/sample_serp.json.
SEARCHAPI_KEY=
SERPAPI_KEY=

# --- LLM for labelling sites. Tried in this order: Gemini -> Claude -> OpenAI ---
# Without any of them: simple rules from serp_mvp/rules.py.
# https://aistudio.google.com/apikey (free)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# https://console.anthropic.com (paid)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# https://platform.openai.com/api-keys (paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Google Sheets (see README, "Google Sheets") ---
# Without it: results only in results.xlsx, keywords from keywords.csv.
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=

# --- Notifications after each run ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# --- Only for the bot's /run command ---
GITHUB_REPO=
GITHUB_TOKEN=
